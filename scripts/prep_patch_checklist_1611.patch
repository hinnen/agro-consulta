+{% load static %}
+<!DOCTYPE html>
+<html lang="pt-BR">
+<head>
+  <meta charset="utf-8">
+  <title>Cartões em branco</title>
+  <style>
+    @page { size: A4; margin: 8mm; }
+    body { margin: 0; font-family: Arial, sans-serif; color: #0f172a; }
+    .no-print { padding: 16px; }
+    .folha { display: grid; grid-template-columns: 85.6mm 85.6mm; gap: 4mm; justify-content: center; }
+    .cartao {
+      width: 85.6mm; height: 56mm; position: relative; overflow: hidden;
+      border: 0.2mm dashed #94a3b8; box-sizing: border-box; background: #fff;
+      break-inside: avoid; page-break-inside: avoid;
+    }
+    .arte { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: fill; }
+    .faixa { position: absolute; left: 0; right: 0; top: 0; height: 16mm; background: #047857; color: #fff; padding: 3mm 4mm; }
+    .faixa strong { display: block; font-size: 14pt; }
+    .faixa span { font-size: 8pt; }
+    .buraco-barras, .buraco-qr { position: absolute; background: #fff; display: flex; align-items: center; justify-content: center; }
+    .cartao.com-arte .buraco-barras { left: 6%; top: 65%; width: 53%; height: 27%; }
+    .cartao.com-arte .buraco-qr { left: 69%; top: 54.5%; width: 26%; height: 39%; }
+    .cartao.sem-arte .buraco-barras { left: 3mm; bottom: 3mm; width: 50mm; height: 16mm; }
+    .cartao.sem-arte .buraco-qr { right: 3mm; bottom: 3mm; width: 24mm; height: 24mm; }
+    .buraco-qr svg { width: 92%; height: 92%; display: block; }
+    .buraco-barras { flex-direction: column; }
+    .buraco-barras svg { width: 96%; height: 70%; }
+    .numero-cartao { margin: 0; font: 700 7pt ui-monospace, monospace; letter-spacing: 0.04em; color: #0f172a; }
+    button, label { font-size: 16px; font-weight: 800; }
+    @media print { .no-print { display: none; } .cartao { border: none; } }
+  </style>
+</head>
+<body>
+  <form class="no-print" method="post">
+    {% csrf_token %}
+    <p><a href="{% url 'caixa_painel' %}">Voltar ao caixa</a></p>
+    <label>Quantos cartões <input name="qtd" value="8" inputmode="numeric" style="width:4rem;font-size:18px;font-weight:800"></label>
+    <button type="submit">Gerar folha</button>
+    {% if blocos %}<button type="button" onclick="window.print()">Imprimir</button>{% endif %}
+    <p>Papel de foto A4. 8 cartões cabem com folga. Corte no risco.</p>
+  </form>
+  {% if blocos %}
+  <div class="folha">
+    {% for b in blocos %}
+    <article class="cartao {% if tem_arte %}com-arte{% else %}sem-arte{% endif %}">
+      {% if tem_arte %}
+      <img class="arte" src="{% static 'produtos/img/cartao_cliente_arte.png' %}" alt="">
+      {% else %}
+      <div class="faixa"><strong>GM Agro</strong><span>Cartão do cliente</span></div>
+      {% endif %}
+      <div class="buraco-barras"><svg id="bc-{{ forloop.counter }}"></svg><p class="numero-cartao">{{ b.codigo }}</p></div>
+      <div class="buraco-qr">{{ b.qr|safe }}</div>
+    </article>
+    {% endfor %}
+  </div>
+  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
+  <script>
+    var codigos = [{% for b in blocos %}"{{ b.codigo }}"{% if not forloop.last %},{% endif %}{% endfor %}];
+    codigos.forEach(function (codigo, i) {
+      try {
+        JsBarcode("#bc-" + (i + 1), codigo, {
+          format: "EAN13", displayValue: false, margin: 0, height: 50, width: 1.6, background: "#ffffff"
+        });
+      } catch (e) {}
+    });
+  </script>
+  {% endif %}
+</body>
+</html>
