# Copie para a RAIZ do repo como ".env.wa-servidor" (ao lado de manage.py).
# O subir_servidor.bat carrega este arquivo — nao sobrescreve seu .env de dev.
#
# Postgres local so do modulo WhatsApp (crie banco agro_wa no pgAdmin ou psql).
DATABASE_URL=postgres://agro_wa:SUA_SENHA@127.0.0.1:5432/agro_wa
SECRET_KEY=troque-por-uma-chave-longa-aleatoria
AGRO_WA_BRIDGE_TOKEN=gm-agro-wa-ponte-local
#
# Pasta FORA do repo — fotos/audios persistem (nao some no git pull).
AGRO_WA_MEDIA_ROOT=C:\AgroWhatsApp\Dados\media
#
# Servidor WA nao precisa Mongo ERP na loja.
AGRO_MONGO_ERP_DESLIGADO=true
AGRO_PDV_VENDA_SEM_MONGO_ERP=true
AGRO_FONTE_CATALOGO=agro_pg
AGRO_FONTE_FINANCEIRO=agro_pg
#
# Quando usar tunel Cloudflare (URL publica), acrescente o host abaixo.
# Ex.: ALLOWED_HOSTS_EXTRA=127.0.0.1,localhost,zap.seudominio.com.br
ALLOWED_HOSTS_EXTRA=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS_EXTRA=https://127.0.0.1:8000,http://127.0.0.1:8000
#
# URL publica HTTPS (tunel) — preencha depois do cloudflared; usada em links se necessario.
# AGRO_CANONICAL_ORIGIN=https://zap.seudominio.com.br
#
# NAO definir AGRO_WA_PUBLIC_ORIGIN neste host (so no PDV Sistvale quando Zap ficava no Render).
