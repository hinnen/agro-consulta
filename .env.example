# Copie para ".env" (nunca commite o .env — está no .gitignore).
#
# Mongo (espelho do ERP — PDV, Cadastro ERP aba "Espelho ERP", financeiro, etc.)
# Sem isso, a aba "Espelho ERP" mostra "Mongo indisponível"; a aba "Grupos" do Cadastro ERP funciona só com o banco Django.
# VENDA_ERP_MONGO_URL=mongodb://usuario:senha@host:27017
# VENDA_ERP_MONGO_DB=nome_do_database
#
# Postgres Django (login, PIN, caixa turno, AjusteRapidoEstoque, entrada NF na camada Agro, etc.)
# DATABASE_URL=postgres://USER:SENHA@HOST:5432/NOMEDB
# DEV LOCAL (recomendado): omita DATABASE_URL → SQLite em db.sqlite3 (isolado do Render).
# Busca PDV / catálogo local exige Mongo espelho (sem isso `/api/todos-produtos/delta/` falha):
# VENDA_ERP_MONGO_URL=mongodb://...
# VENDA_ERP_MONGO_DB=nome_do_database
# PRODUÇÃO (Render): DATABASE_URL vem do painel Render — não copie para o .env local.
#
# SaveInCloud (ou outro servidor) com os MESMOS saldos que o Render:
#   Copie do painel Render para o env do Docker/SaveInCloud as MESMAS linhas:
#   VENDA_ERP_MONGO_URL, VENDA_ERP_MONGO_DB, DATABASE_URL (e REDIS_URL se o Render usar).
#   O Mongo traz o espelho ERP; os ajustes Agro (nota, transferência, PIN) ficam no Postgres Django.
#   Atenção: duas apps a apontar para o mesmo Postgres = duas escritas na mesma base (homolog ok; produção só se for intencional).
#
# PDV wizard — tamanho do catálogo em cache no navegador (padrão 5000; teto 8000).
# AGRO_WIZARD_CATALOG_MAX=5000
#
# --- Desvinculação ERP (feat/desvincula-erp) — default = legado (produção inalterada) ---
# AGRO_FONTE_CATALOGO=legacy          # legacy | agro_pg
# AGRO_FONTE_ESTOQUE=legacy           # legacy | ledger
# AGRO_FONTE_FINANCEIRO=legacy        # legacy | agro_pg (loja só com OK Renan)
# AGRO_FINANCEIRO_PG_LEITURA_STAGING=true  # staging: CP lê PG após bootstrap (default true)
# AGRO_FINANCEIRO_ERP_SYNC_HABILITADO=false   # false = não envia lançamento/baixa ao ERP (só Mongo)
# AGRO_FINANCEIRO_MONGO_CONGELADO=false       # true após: python manage.py congelar_lancamentos_financeiro_agro
# AGRO_ERP_PEDIDOS_DRY_RUN=false      # true no staging — não POST Pedidos/Salvar
# Staging Render: serviço separado + Postgres próprio (nunca o DATABASE_URL da loja).
# AGRO_STAGING_READONLY=true          # staging: lê Mongo da loja, não grava preço/financeiro no Mongo
# AGRO_SNAPSHOT_FONTE_DATABASE_URL=   # staging: Internal URL Postgres loja → copiar snapshot PDV
# AGRO_PDV_CATALOGO_SOMENTE_POSTGRES=false  # staging: true só após copiar snapshot + validar preços
# Snapshot: python manage.py copiar_snapshot_pdv_loja
# Import catálogo PG: python manage.py importar_catalogo_mongo_produto
# Status flags: GET /api/agro/fonte-status/
#
# Opcional — timeouts PyMongo (ms). No Render, se aparecer "timed out" em médias/transferência, suba socket (ex.: 180000).
# AGRO_MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
# AGRO_MONGO_CONNECT_TIMEOUT_MS=20000
# AGRO_MONGO_SOCKET_TIMEOUT_MS=120000
#
# Empréstimos — textos de PlanoDeConta no Mongo exatamente como no ERP (opcional; vazio = padrão do código + regex legada).
# AGRO_EMPRESTIMO_PLANO_ENTRADA=Entrada de Empréstimo
# AGRO_EMPRESTIMO_PLANO_DIVIDA=Pagamento de Empréstimos
# AGRO_EMPRESTIMO_PLANO_JUROS=Juros de Empréstimos
# Empréstimos — consulta: clientes (Mongo) a ocultar na lista, vírgula. Soma à lista embutida no código.
# AGRO_EMPRESTIMO_EXCLUIR_CLIENTES=Fulano Ltda,Beltrano SA
# Pedidos/Salvar (PDV → ERP): plano de contas exatamente como no cadastro ERP (ex.: Vendas Pdv ou 1.1.1 — Vendas Pdv).
# VENDA_ERP_PEDIDO_PLANO_CONTA=Vendas Pdv
# Opcional — ID Mongo do plano (só se souber o _id; vazio = busca automática no Mongo):
# VENDA_ERP_PEDIDO_PLANO_CONTA_ID=
#
# Mercado Pago Point (PDV — cobrança no terminal)
MP_POINT_ENABLED=True
MP_POINT_ACCESS_TOKEN=
MP_POINT_TERMINAL_ID=NEWLAND_N950__N950NCC804354777
MP_POINT_EXPIRATION=PT16M
MP_POINT_PRINT_ON_TERMINAL=no_ticket

# Opcional: OAuth (outros fluxos). Não use Client Secret no front-end.
# MP_OAUTH_CLIENT_ID=
# MP_OAUTH_CLIENT_SECRET=

# --- NFC-e (cupom fiscal PDV — São Paulo, Simples Nacional) ---
# NFC_E_ENABLED=true
# NFC_E_TP_AMB=2
# NFC_E_CERT_PATH=C:/caminho/certificado.pfx
# NFC_E_CERT_PASSWORD=senha_do_certificado
# Render: NFC_E_CERT_BASE64=<pfx em base64, uma linha>
# NFC_E_CNPJ=00000000000000
# NFC_E_IE=000000000000
# NFC_E_RAZAO_SOCIAL=Razão Social conforme certificado
# NFC_E_FANTASIA=Nome na loja / cupom
# NFC_E_LOGRADOURO=Av. Exemplo
# NFC_E_NUMERO=123
# NFC_E_BAIRRO=Centro
# Código IBGE 7 dígitos (Jacupiranga/SP = 3524600; não confundir com Guaiçara 3521900)
# NFC_E_CMUN=3524600
# NFC_E_CIDADE=Jacupiranga
# NFC_E_UF=SP
# NFC_E_CEP=11940000
# NFC_E_FONE=13999999999
# NFC_E_CSC_ID=1
# NFC_E_CSC_TOKEN=token_sefaz_sp
# NFC_E_SERIE=21
# NFC_E_PROXIMO_NUMERO=1
# manual (padrão) = PIX/cartões automático · demais formas = checkbox no PDV
# auto = emite NFC-e em toda venda
# NFC_E_MODO=manual
# Tributos aproximados (Lei 12.741) — opcional: token IBPT (deolhonoimposto.com.br)
# NFC_E_IBPT_TOKEN=
# NFC_E_IBPT_CNPJ=48900774000103
# Sem token: alíquotas médias fallback (% sobre o valor de cada item)
# NFC_E_IBPT_ALIQ_NAC=13.45
# NFC_E_IBPT_ALIQ_EST=18.00
# NFC_E_IBPT_ALIQ_MUN=0
#
# Contabilidade — login dedicado ao escritório (sem PDV/caixa). Crie o usuário no Admin Django
# e liste o username aqui (vírgula). Staff/superuser também acessam /contabilidade/.
# AGRO_CONTABILIDADE_USERNAMES=contador
